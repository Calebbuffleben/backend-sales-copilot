// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenant core
//
// Identity model (non-negotiable):
//  - `User` is a GLOBAL identity. Email is unique across the platform.
//  - `Tenant` is a company/workspace.
//  - `Membership` links a User to a Tenant with a role. A user can belong
//    to many tenants and a tenant can have many users.
//  - `Subscription` is the billing record per tenant (plan + seat limit).
//  - `Invitation` is a pending link (tokenized) that becomes a Membership
//    when the invitee accepts.
//
// The JWT access token carries `sub` (userId), `tid` (tenantId) and `mid`
// (membershipId). The `mid` is the authoritative permission anchor — the
// backend rechecks it on every protected request.
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

model Tenant {
  id        String       @id @default(uuid())
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships       Membership[]
  invitations       Invitation[]
  subscription      Subscription?
  sessions          Session[]
  feedbackEvents    FeedbackEvent[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  playbookTemplates PlaybookTemplate[]
  sellerRooms       SellerRoom[]
  specialistPreferences UserSpecialistPreference[]
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  name         String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships              Membership[]
  refreshTokens            RefreshToken[]
  sentInvites              Invitation[]            @relation("InvitationInvitedBy")
  sellerRoomsCreated       SellerRoom[]            @relation("SellerRoomCreatedBy")
  sellerRoomMemberships    SellerRoomMember[]
  sellerRoomInvitesSent    SellerRoomInvitation[]  @relation("SellerRoomInvitationInvitedBy")
  sellerRoomInvitesReceived SellerRoomInvitation[] @relation("SellerRoomInvitationInvitee")
  specialistPreferences    UserSpecialistPreference[]
}

model Membership {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      MembershipRole @default(MEMBER)
  // Null when OWNER created the tenant; otherwise the membership that invited them.
  invitedBy String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Invitation {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        MembershipRole @default(MEMBER)
  // sha256(tokenPlaintext) — plaintext is returned to the admin ONCE.
  tokenHash   String         @unique
  status      InviteStatus   @default(PENDING)
  invitedById String?
  invitedBy   User?          @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([expiresAt])
}

model Subscription {
  id        String             @id @default(uuid())
  tenantId  String             @unique
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      Plan               @default(FREE)
  maxUsers  Int                @default(3)
  status    SubscriptionStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([tenantId])
}

model RefreshToken {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Membership that minted this token. Used to short-circuit revoke when a
  // membership is removed (admin removes a user) and as an extra sanity
  // anchor during refresh (we re-verify the membership still exists).
  membershipId String?
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdByIp  String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([familyId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  target    String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Meeting / feedback domain (tenant-scoped)
// ---------------------------------------------------------------------------

/// Tenant-defined actionable playbook (steps stored as JSON; validated in app layer).
/// PDF source is ingested at admin upload time only — Live catalog gets sourceTextExcerpt.
model PlaybookTemplate {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key                String
  title              String
  description        String?
  steps              Json
  /// Original PDF filename for admin UI (no binary stored).
  sourcePdfFileName  String?
  /// Full extracted text (admin/DB only; never sent on Live catalog).
  sourceText         String?
  /// Short excerpt (~2k) for Live TF-IDF + system_instruction catalog.
  sourceTextExcerpt  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

enum SessionStatus {
  ACTIVE
  ENDED
}

model Session {
  id                String        @id @default(uuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meetingId         String
  roomSid           String?       @unique
  roomName          String
  status            SessionStatus @default(ACTIVE)
  startedAt         DateTime      @default(now())
  endedAt           DateTime?
  lastSeenAt        DateTime      @default(now())
  activeConnections Int           @default(0)
  audioSeconds      Int           @default(0)
  metadata          Json?

  @@unique([tenantId, meetingId])
  @@index([roomName])
  @@index([tenantId])
  @@index([tenantId, status, lastSeenAt])
}

model OperationalEvent {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  service       String
  stage         String
  message       String
  tenantId      String?
  meetingId     String?
  userId        String?
  participantId String?
  traceId       String?
  severity      String   @default("info")
  durationMs    Int?
  metadata      Json?

  @@index([tenantId, timestamp])
  @@index([meetingId, timestamp])
  @@index([userId, timestamp])
  @@index([traceId])
  @@index([stage, timestamp])
}

model UsageDailyAggregate {
  id                         String   @id @default(uuid())
  date                       DateTime
  tenantId                   String?
  meetingsCount              Int      @default(0)
  audioSeconds               Int      @default(0)
  transcriptionWindows       Int      @default(0)
  feedbacksCount             Int      @default(0)
  geminiRequests             Int      @default(0)
  geminiEstimatedCostUsd     Decimal  @default(0) @db.Decimal(12, 6)
  assemblyAiSeconds          Int      @default(0)
  assemblyAiEstimatedCostUsd Decimal  @default(0) @db.Decimal(12, 6)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([date, tenantId])
  @@index([tenantId, date])
}

enum FeedbackSeverity {
  info
  warning
  critical
}

enum FeedbackType {
  llm_insight
}

model FeedbackEvent {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meetingId     String
  participantId String
  type          FeedbackType
  severity      FeedbackSeverity
  ts            DateTime
  windowStart   DateTime
  windowEnd     DateTime
  message       String
  metadata      Json
  createdAt     DateTime         @default(now())
  expiresAt     DateTime?

  @@index([tenantId, meetingId, ts])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Seller Rooms — acoustic sync between co-sellers (no fingerprint persistence)
// ---------------------------------------------------------------------------

enum SellerRoomStatus {
  OPEN
  ACTIVE
  ENDED
  ARCHIVED
}

enum SellerRoomMemberStatus {
  INVITED
  JOINED
  LEFT
}

enum SellerRoomInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model SellerRoom {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meetingId   String
  name        String
  status      SellerRoomStatus @default(OPEN)
  createdById String
  createdBy   User             @relation("SellerRoomCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  meetUrl     String?
  metadata    Json?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members      SellerRoomMember[]
  invitations  SellerRoomInvitation[]

  @@index([tenantId, status])
  @@index([tenantId, meetingId])
  @@index([createdById])
}

model SellerRoomMember {
  id           String                 @id @default(uuid())
  sellerRoomId String
  sellerRoom   SellerRoom             @relation(fields: [sellerRoomId], references: [id], onDelete: Cascade)
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       SellerRoomMemberStatus @default(INVITED)
  joinedAt     DateTime?
  leftAt       DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([sellerRoomId, userId])
  @@index([userId])
  @@index([sellerRoomId, status])
}

model SellerRoomInvitation {
  id           String                      @id @default(uuid())
  sellerRoomId String
  sellerRoom   SellerRoom                  @relation(fields: [sellerRoomId], references: [id], onDelete: Cascade)
  inviteeId    String
  invitee      User                        @relation("SellerRoomInvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  invitedById  String
  invitedBy    User                        @relation("SellerRoomInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  status       SellerRoomInvitationStatus  @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@index([sellerRoomId, status])
  @@index([inviteeId, status])
}

enum SpecialistStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SpecialistSource {
  CODE
  CUSTOM
}

/// Global coaching specialist (platform-admin). Code builtins upsert via Python.
model SpecialistTemplate {
  id              String            @id @default(uuid())
  key             String            @unique
  name            String
  description     String            @default("")
  instructions    String            @default("")
  tone            String            @default("")
  exampleMessage  String            @default("")
  triggerPhases   String[]          @default([])
  triggerKeywords String[]          @default([])
  minConfidence   Float             @default(0.6)
  cooldownSec     Int               @default(15)
  priority        Int               @default(100)
  model           String            @default("gemini-2.5-flash")
  maxLatencyMs    Int               @default(4000)
  status          SpecialistStatus  @default(DRAFT)
  enabled         Boolean           @default(true)
  source          SpecialistSource  @default(CUSTOM)
  icon            String?
  color           String?
  lastDryRunAt    DateTime?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  versions        SpecialistVersion[]

  @@index([status, enabled])
  @@index([source])
}

model SpecialistVersion {
  id           String             @id @default(uuid())
  specialistId String
  specialist   SpecialistTemplate @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json
  createdAt    DateTime           @default(now())

  @@unique([specialistId, version])
  @@index([specialistId])
}

model UserSpecialistPreference {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  specialistKeys  String[]
  updatedAt       DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
}
